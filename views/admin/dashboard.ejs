<%- include('partials/header') %>

  <div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
      <div class="col-lg-8 mb-4 order-0">
        <div class="card">
          <div class="d-flex align-items-end row">
            <div class="col-sm-7">
              <div class="card-body">
                <h5 class="card-title text-primary">Chào ngày mới, <%= user ? user.username : 'Admin' %>! 🎉</h5>
                <p class="mb-4">
                  Bạn có <span class="fw-bold text-danger">
                    <%= typeof totalOrders !=='undefined' ? totalOrders : 0 %>
                  </span> đơn hàng trong hệ thống. Hãy kiểm tra các đơn hàng mới đang chờ xử lý nhé.
                </p>
                <a href="/admin/orders" class="btn btn-sm btn-outline-primary">Xem Đơn Hàng Ngay</a>
              </div>
            </div>
            <div class="col-sm-5 text-center text-sm-left">
              <div class="card-body pb-0 px-0 px-md-4">
                <img src="/admin_assets/img/illustrations/man-with-laptop-light.png" height="140"
                  alt="View Badge User" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4 col-md-4 order-1">
        <div class="row">
          <div class="col-lg-6 col-md-12 col-6 mb-4">
            <div class="card">
              <div class="card-body">
                <div class="card-title d-flex align-items-start justify-content-between">
                  <div class="avatar flex-shrink-0">
                    <i class="fas fa-box-open fa-2x text-success"></i>
                  </div>
                </div>
                <span class="fw-semibold d-block mb-1">Tổng sản phẩm</span>
                <h3 class="card-title mb-2">
                  <%= totalProducts %>
                </h3>
                <small class="text-success fw-semibold">Mặt hàng</small>
              </div>
            </div>
          </div>
          <div class="col-lg-6 col-md-12 col-6 mb-4">
            <div class="card">
              <div class="card-body">
                <div class="card-title d-flex align-items-start justify-content-between">
                  <div class="avatar flex-shrink-0">
                    <i class="fas fa-users fa-2x text-info"></i>
                  </div>
                </div>
                <span>Khách hàng</span>
                <h3 class="card-title text-nowrap mb-1">
                  <%= totalUsers %>
                </h3>
                <small class="text-success fw-semibold">Tài khoản</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-12 order-2 mb-4">
        <div class="card">
          <div class="row row-bordered g-0">
            <div class="col-md-8 p-4">
              <h5 class="card-header m-0 me-2 pb-3 px-0">Tổng Doanh Thu Hệ Thống</h5>
              <h2 class="text-primary fw-bold">
                <%= totalRevenue.toLocaleString('vi-VN') %> VNĐ
              </h2>
              <p class="text-muted">Tổng số tiền thu được từ tất cả các đơn hàng thành công trên EduStore.</p>
            </div>
            <div class="col-md-4 d-flex align-items-center justify-content-center bg-light">
              <div class="text-center p-4">
                <h5 class="mb-2">Thống kê nhanh</h5>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                  <span>Doanh thu trung bình/Đơn:</span>
                  <strong class="text-dark">
                    <%= totalOrders> 0 ? Math.round(totalRevenue / totalOrders).toLocaleString('vi-VN') : 0 %> đ
                  </strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>