<%- include('partials/header') %>

    <div class="container-fluid page-header py-5 bg-dark mb-5">
        <h1 class="text-center text-white display-6">Giỏ Hàng Của Bạn</h1>
    </div>

    <div class="container-fluid py-5">
        <div class="container py-5">
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Hình Ảnh</th>
                            <th scope="col">Tên Sản Phẩm</th>
                            <th scope="col">Mã (SKU)</th>
                            <th scope="col">Giá Bán</th>
                            <th scope="col">Số Lượng</th>
                            <th scope="col">Tổng cộng</th>
                            <th scope="col">Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (cartItems && cartItems.length> 0) { %>
                            <% cartItems.forEach(item=> { %>
                                <tr>
                                    <td>
                                        <img src="<%= item.imageUrl %>" class="img-fluid rounded shadow-sm"
                                            style="width: 60px; height: 60px; object-fit: contain;"
                                            alt="<%= item.name %>">
                                    </td>
                                    <td class="text-start">
                                        <p class="mb-0 fw-bold">
                                            <%= item.name %>
                                        </p>
                                    </td>
                                    <td>
                                        <p class="mb-0 text-muted">
                                            <%= item.sku %>
                                        </p>
                                    </td>
                                    <td>
                                        <p class="mb-0">
                                            <%= item.price.toLocaleString('vi-VN') %> đ
                                        </p>
                                    </td>
                                    <td>
                                        <div class="input-group quantity mx-auto" style="width: 120px;">
                                            <button
                                                class="btn btn-sm btn-minus rounded-circle bg-light border d-flex align-items-center justify-content-center ajax-update-btn"
                                                data-id="<%= item._id %>" data-action="decrease"
                                                style="width: 30px; height: 30px;">
                                                <i class="fa fa-minus"></i>
                                            </button>

                                            <input type="text" id="qty-<%= item._id %>"
                                                class="form-control form-control-sm text-center border-0 bg-transparent fw-bold"
                                                value="<%= item.quantity %>" readonly>

                                            <button
                                                class="btn btn-sm btn-plus rounded-circle bg-light border d-flex align-items-center justify-content-center ajax-update-btn"
                                                data-id="<%= item._id %>" data-action="increase"
                                                style="width: 30px; height: 30px;">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <p class="mb-0 text-danger fw-bold">
                                            <%= item.subtotal.toLocaleString('vi-VN') %> đ
                                        </p>
                                    </td>
                                    <td>
                                        <a href="/cart/remove/<%= item._id %>"
                                            class="btn btn-md rounded-circle bg-light border text-danger">
                                            <i class="fa fa-times"></i>
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <h4 class="mb-3">🛒 Giỏ hàng của bạn đang trống!</h4>
                                                <a href="/" class="btn btn-primary rounded-pill px-4 py-2">Quay lại mua
                                                    sắm ngay</a>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (cartItems && cartItems.length> 0) { %>
                <% const shipping=30000; // Đặt phí ship cố định dễ quản lý là 30k %>
                    <div class="row g-4 justify-content-end mt-5">
                        <div class="col-8"></div>
                        <div class="col-sm-8 col-md-7 col-lg-6 col-xl-4">
                            <div class="bg-light rounded p-4 shadow-sm border">
                                <h4 class="mb-4 border-bottom pb-2">Tóm tắt đơn hàng</h4>
                                <div class="d-flex justify-content-between mb-3">
                                    <h6 class="mb-0">Tạm tính:</h6>
                                    <p class="mb-0 fw-bold">
                                        <%= subtotal.toLocaleString('vi-VN') %> đ
                                    </p>
                                </div>
                                <div class="d-flex justify-content-between mb-4">
                                    <h6 class="mb-0">Phí vận chuyển:</h6>
                                    <p class="mb-0 text-muted">
                                        <%= shipping.toLocaleString('vi-VN') %> đ
                                    </p>
                                </div>
                                <div
                                    class="py-3 mb-4 border-top border-bottom d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Tổng cộng:</h5>
                                    <h4 class="mb-0 text-danger fw-bold">
                                        <%= (subtotal + shipping).toLocaleString('vi-VN') %> đ
                                    </h4>
                                </div>
                                <a href="/checkout"
                                    class="btn btn-primary w-100 rounded-pill py-3 text-uppercase fw-bold">Tiến hành
                                    thanh toán</a>
                            </div>
                        </div>
                    </div>
                    <% } %>
        </div>
    </div>

    <script>
        document.querySelectorAll('.ajax-update-btn').forEach(button => {
            button.addEventListener('click', async function () {
                const productId = this.getAttribute('data-id');
                const action = this.getAttribute('data-action');

                try {
                    // Gọi API ngầm xuống server
                    const response = await fetch('/api/cart/update', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, action })
                    });

                    const data = await response.json();

                    if (data.success) {
                        if (data.newQuantity === 0) {
                            // Nếu số lượng về 0, load lại trang để xóa mất dòng đó đi cho đẹp
                            window.location.reload();
                        } else {
                            // Cập nhật số lượng mới
                            document.getElementById(`qty-${productId}`).value = data.newQuantity;

                            // Cập nhật thành tiền của món đó
                            document.getElementById(`subtotal-${productId}`).innerText = data.newSubtotal.toLocaleString('vi-VN') + ' đ';

                            // Cập nhật Tổng hóa đơn bên tay phải
                            const ship = 30000;
                            document.getElementById('cart-tamtinh').innerText = data.cartTotal.toLocaleString('vi-VN') + ' đ';
                            document.getElementById('cart-tongcong').innerText = (data.cartTotal + ship).toLocaleString('vi-VN') + ' đ';
                        }
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                } catch (error) {
                    console.error('Lỗi khi gọi API:', error);
                }
            });
        });
    </script>
    <%- include('partials/footer') %>