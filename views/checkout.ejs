<%- include('partials/header') %>

    <div class="container-fluid page-header py-5 bg-secondary text-center mb-5">
        <h1 class="text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Thanh Toán Đơn Hàng</h1>
    </div>

    <div class="container-fluid py-5">
        <div class="container py-5">
            <form action="/checkout" method="POST">
                <div class="row g-5">
                    <div class="col-md-12 col-lg-6 col-xl-7">
                        <h3 class="mb-4">Thông tin giao hàng</h3>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Họ và Tên người nhận <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="name"
                                    value="<%= user ? user.username : '' %>" required>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" name="phone" required
                                    placeholder="Ví dụ: 0987654321">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Địa chỉ chi tiết (Số nhà, Tên đường) <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="address" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Quận / Huyện <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="district" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="city" value="Gia Lai" required>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Ghi chú đơn hàng (Tùy chọn)</label>
                                <textarea name="notes" class="form-control" spellcheck="false" cols="30" rows="4"
                                    placeholder="Ví dụ: Giao hàng giờ hành chính..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12 col-lg-6 col-xl-5">
                        <div class="card border-primary mb-5 shadow-sm">
                            <div class="card-header bg-primary border-0 text-white">
                                <h4 class="font-weight-semi-bold m-0 text-white">Đơn hàng của bạn</h4>
                            </div>
                            <div class="card-body">
                                <h5 class="font-weight-medium mb-3">Sản phẩm</h5>

                                <% if (cartItems && cartItems.length> 0) { %>
                                    <% cartItems.forEach(item=> { %>
                                        <div class="d-flex justify-content-between">
                                            <p>
                                                <%= item.name %> <strong>x <%= item.quantity %></strong>
                                            </p>
                                            <p>
                                                <%= item.subtotal.toLocaleString('vi-VN') %> đ
                                            </p>
                                        </div>
                                        <% }) %>
                                            <% } %>

                                                <hr class="mt-0">
                                                <div class="d-flex justify-content-between mb-3 pt-1">
                                                    <h6 class="font-weight-medium">Tạm tính</h6>
                                                    <h6 class="font-weight-medium">
                                                        <%= (subtotal || 0).toLocaleString('vi-VN') %> đ
                                                    </h6>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <% const shippingFee=30000; %>
                                                        <h6 class="font-weight-medium">Phí vận chuyển</h6>
                                                        <h6 class="font-weight-medium">
                                                            <%= shippingFee.toLocaleString('vi-VN') %> đ
                                                        </h6>
                                                </div>
                            </div>
                            <div class="card-footer border-secondary bg-transparent">
                                <div class="d-flex justify-content-between mt-2">
                                    <h5 class="font-weight-bold">Tổng Thanh Toán</h5>
                                    <h5 class="font-weight-bold text-danger">
                                        <%= ((subtotal || 0) + shippingFee).toLocaleString('vi-VN') %> đ
                                    </h5>
                                </div>
                            </div>
                        </div>

                        <div class="card border-secondary mb-5 shadow-sm">
                            <div class="card-header bg-secondary border-0">
                                <h4 class="font-weight-semi-bold m-0">Thanh toán</h4>
                            </div>
                            <div class="card-body">
                                <div class="form-group mb-3">
                                    <div class="custom-control custom-radio">
                                        <input type="radio" class="custom-control-input" name="paymentMethod" id="cod"
                                            value="COD" checked>
                                        <label class="custom-control-label fw-bold text-dark" for="cod">Thanh toán khi
                                            nhận hàng (COD)</label>
                                        <small class="d-block text-muted mt-1">Bạn sẽ thanh toán bằng tiền mặt cho
                                            shipper khi nhận được hàng.</small>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="custom-control custom-radio">
                                        <input type="radio" class="custom-control-input" name="paymentMethod" id="bank"
                                            value="Bank Transfer">
                                        <label class="custom-control-label fw-bold text-dark" for="bank">Chuyển khoản
                                            ngân hàng</label>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer border-secondary bg-transparent">
                                <button type="submit"
                                    class="btn btn-primary w-100 py-3 text-uppercase fw-bold rounded-pill">Xác Nhận Đặt
                                    Hàng</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>