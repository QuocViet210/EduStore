<%- include('partials/header') %>

    <div class="container-fluid carousel bg-light px-0">
        <div class="row g-0 justify-content-end">
            <div class="col-12 col-lg-7 col-xl-9">
                <div class="header-carousel owl-carousel bg-light py-5">
                    <div class="row g-0 header-carousel-item align-items-center">
                        <div class="col-xl-6 carousel-img wow fadeInLeft" data-wow-delay="0.1s">
                            <img src="/img/van-phong-pham-05.png" class="img-fluid w-100" alt="Image">
                        </div>
                        <div class="col-xl-6 carousel-content p-4">
                            <h4 class="text-uppercase fw-bold mb-4" style="letter-spacing: 3px;">Đồ dùng học tập</h4>
                            <h1 class="display-3 text-capitalize mb-4">Mùa Tựu Trường - Giảm đến 50k</h1>
                            <a class="btn btn-primary rounded-pill py-3 px-5" href="#products-section">Mua ngay</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5 col-xl-3 wow fadeInRight" data-wow-delay="0.1s">
                <div class="carousel-header-banner h-100">
                    <img src="/img/van-phong-pham-03.jpg" class="img-fluid w-100 h-100" style="object-fit: cover;"
                        alt="Image">
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-0">
        <div class="row g-0">
            <div class="col-6 col-md-4 col-lg-3 border-start border-end p-4 text-center">
                <i class="fa fa-sync-alt fa-2x text-primary mb-2"></i>
                <h6>Hoàn trả miễn phí</h6>
            </div>
            <div class="col-6 col-md-4 col-lg-3 border-end p-4 text-center">
                <i class="fab fa-telegram-plane fa-2x text-primary mb-2"></i>
                <h6>Giao hàng toàn quốc</h6>
            </div>
            <div class="col-6 col-md-4 col-lg-3 border-end p-4 text-center">
                <i class="fas fa-life-ring fa-2x text-primary mb-2"></i>
                <h6>Hỗ trợ 24/7</h6>
            </div>
            <div class="col-6 col-md-4 col-lg-3 border-end p-4 text-center">
                <i class="fas fa-lock fa-2x text-primary mb-2"></i>
                <h6>Thanh toán an toàn</h6>
            </div>
        </div>
    </div>

    <div class="container-fluid products py-5" id="products-section">
        <div class="container py-5">
            <div class="mx-auto text-center mb-5" style="max-width: 900px;">
                <h4 class="text-primary border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">
                    Cửa Hàng Của Chúng Tôi
                </h4>
                <h1 class="mb-0 display-3">Tất Cả Sản Phẩm</h1>
            </div>

            <div class="row g-4 justify-content-center">
                <% if (products && products.length> 0) { %>
                    <% products.forEach(product=> { %>
                        <div class="col-6 col-md-4 col-lg-3">
                            <div
                                class="product-item border rounded h-100 d-flex flex-column shadow-sm hover-shadow transition">

                                <div class="product-img position-relative overflow-hidden p-3 border-bottom">
                                    <img src="<%= product.imageUrl %>" class="img-fluid w-100"
                                        style="height: 200px; object-fit: contain;" alt="<%= product.name %>">

                                    <div
                                        class="product-action position-absolute top-50 start-50 translate-middle opacity-0">
                                        <a class="btn btn-square btn-primary rounded-circle m-1"
                                            href="/product/<%= product._id %>">
                                            <i class="fa fa-eye text-white"></i>
                                        </a>
                                    </div>
                                </div>

                                <div class="product-content p-3 text-center flex-grow-1">
                                    <a href="/product/<%= product._id %>"
                                        class="d-block h5 text-dark fw-bold text-truncate mb-2"
                                        title="<%= product.name %>">
                                        <%= product.name %>
                                    </a>
                                    <span class="text-primary fs-5 fw-bold">
                                        <%= product.price.toLocaleString('vi-VN') %> VNĐ
                                    </span>
                                </div>

                                <div class="product-add p-3 text-center border-top bg-light">
                                    <a href="/cart/add/<%= product._id %>"
                                        class="btn btn-outline-primary rounded-pill py-1 px-3">
                                        <i class="fas fa-shopping-cart me-2"></i> Thêm vào giỏ
                                    </a>
                                </div>

                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="col-12 text-center p-5">
                                    <h5 class="text-muted">Kho hàng đang trống. Hãy thêm các sản phẩm (Bút, Vở, Máy
                                        tính...) vào Database nhé!</h5>
                                </div>
                                <% } %>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>