<%- include('partials/header') %>

    <div class="container-fluid py-5 mt-5">
        <div class="container py-5 text-center">

            <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
            <h2 class="mt-4 text-primary">Đặt hàng thành công!</h2>
            <p class="fs-5">Cảm ơn bạn đã mua sắm tại EduStore. Mã đơn hàng của bạn là: <strong>#<%=
                        order._id.toString().slice(-6).toUpperCase() %></strong></p>

            <div class="row justify-content-center mt-5">
                <div class="col-md-6">
                    <div class="card shadow border-0 rounded-lg">
                        <div class="card-body p-4 text-start">
                            <h4 class="border-bottom pb-2 mb-3">Thông tin thanh toán</h4>
                            <p><strong>Tổng tiền cần thanh toán:</strong> <span class="text-danger fw-bold fs-4">
                                    <%= order.totalPrice.toLocaleString('vi-VN') %> đ
                                </span></p>
                            <p><strong>Phương thức:</strong>
                                <%= order.paymentMethod==='Bank Transfer' ? 'Chuyển khoản ngân hàng'
                                    : 'Thanh toán khi nhận hàng (COD)' %>
                            </p>

                            <% if (order.paymentMethod==='Bank Transfer' ) { %>
                                <div class="alert alert-info mt-4 text-center">
                                    <h5>Mã QR Thanh Toán Tự Động</h5>
                                    <p class="mb-3">Vui lòng quét mã QR dưới đây qua ứng dụng ngân hàng. Nội dung và số
                                        tiền đã được điền sẵn.</p>

                                    <img src="https://img.vietqr.io/image/BIDV-6220317776-compact2.png?amount=<%= order.totalPrice %>&addInfo=Thanh toan don hang <%= order._id.toString().slice(-6).toUpperCase() %>&accountName=PHAM QUOC VIET"
                                        alt="Mã QR Thanh Toán" class="img-fluid rounded border p-2"
                                        style="max-width: 250px;">

                                    <div class="mt-3 text-start bg-white p-3 rounded border">
                                        <p class="mb-1"><strong>Ngân hàng:</strong> BIDV</p>
                                        <p class="mb-1"><strong>Chủ tài khoản:</strong> PHAM QUOC VIET</p>
                                        <p class="mb-1"><strong>Số tài khoản:</strong> 6220317776</p>
                                        <p class="mb-0 text-danger"><strong>Nội dung CK:</strong> Thanh toan don hang
                                            <%= order._id.toString().slice(-6).toUpperCase() %>
                                        </p>
                                    </div>
                                    <p class="text-muted mt-2 mb-0"><small>Đơn hàng sẽ được xử lý ngay khi chúng tôi
                                            nhận được thanh toán.</small></p>
                                </div>
                                <% } else { %>
                                    <div class="alert alert-success mt-4">
                                        <h5 class="text-success"><i class="fas fa-truck me-2"></i>Chờ giao hàng</h5>
                                        <p class="mb-0">Vui lòng chuẩn bị sẵn số tiền <strong>
                                                <%= order.totalPrice.toLocaleString('vi-VN') %> đ
                                            </strong> để thanh toán cho shipper khi nhận được hàng.</p>
                                    </div>
                                    <% } %>

                        </div>
                        <div class="card-footer bg-transparent text-center py-3">
                            <a href="/shop" class="btn btn-outline-primary me-2">Tiếp tục mua sắm</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <%- include('partials/footer') %>