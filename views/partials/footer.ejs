<style>
    #chat-widget {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 320px;
        z-index: 1000;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        border-radius: 10px;
        overflow: hidden;
        display: none;
        flex-direction: column;
        background: #fff;
    }

    #chat-widget-header {
        background: #ff6b6b;
        color: white;
        padding: 10px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
    }

    #chat-widget-body {
        height: 250px;
        overflow-y: auto;
        padding: 10px;
        background: #f9f9f9;
    }

    #chat-widget-footer {
        padding: 10px;
        background: white;
        border-top: 1px solid #ddd;
    }

    .chat-bubble {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #ff6b6b;
        color: white;
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        cursor: pointer;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        transition: 0.3s;
    }

    .chat-bubble:hover {
        transform: scale(1.1);
    }
</style>

<div class="chat-bubble" id="chat-bubble" onclick="toggleChat()">
    <i class="fas fa-comments"></i>
</div>

<div id="chat-widget">
    <div id="chat-widget-header" onclick="toggleChat()">
        <strong><i class="fas fa-headset me-2"></i> Hỗ trợ EduStore</strong>
        <i class="fas fa-times"></i>
    </div>
    <div id="chat-widget-body">
        <ul id="user-messages" class="list-unstyled m-0" style="font-size: 0.9rem;"></ul>
    </div>
    <div id="chat-widget-footer">
        <form id="user-chat-form" class="d-flex m-0">
            <input type="text" id="user-chat-input" class="form-control form-control-sm me-2"
                placeholder="Hỏi chúng tôi..." autocomplete="off" required>
            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-paper-plane"></i></button>
        </form>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    function toggleChat() {
        const widget = document.getElementById('chat-widget');
        const bubble = document.getElementById('chat-bubble');
        if (widget.style.display === 'none' || widget.style.display === '') {
            widget.style.display = 'flex'; bubble.style.display = 'none';
        } else {
            widget.style.display = 'none'; bubble.style.display = 'flex';
        }
    }

    const socketUser = io();
    const userForm = document.getElementById('user-chat-form');
    const userInput = document.getElementById('user-chat-input');
    const userMessages = document.getElementById('user-messages');
    const userChatBody = document.getElementById('chat-widget-body');

    // Xác định tên người dùng (Nếu chưa đăng nhập thì là Khách)
    let myName = "Khách Hàng";
    '<% if (typeof user !== "undefined" && user) { %>'
    myName = '<%= user.username %>';
    '<% } %>'

    userForm.addEventListener('submit', function (e) {
        e.preventDefault();
        if (userInput.value) {
            socketUser.emit('send_message', { sender: myName, message: userInput.value, role: 'user' });
            userInput.value = '';
        }
    });

    socketUser.on('receive_message', function (data) {
        const li = document.createElement('li');
        li.className = 'mb-2';

        if (data.role === 'user') {
            li.innerHTML = `<div class="text-end"><div class="bg-light border p-2 rounded-3 d-inline-block text-dark">${data.message}</div></div>`;
        } else { // Tin nhắn của Admin
            li.innerHTML = `<div class="text-start"><small class="text-danger fw-bold">Admin</small><br><div class="bg-danger text-white p-2 rounded-3 d-inline-block shadow-sm">${data.message}</div></div>`;
        }

        userMessages.appendChild(li);
        userChatBody.scrollTop = userChatBody.scrollHeight; // Cuộn xuống
    });
</script>
