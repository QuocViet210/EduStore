<%- include('partials/header') %>

    <div class="container-fluid page-header py-5">
        <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Trang cửa hàng</h1>
        <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active text-white">Cửa hàng</li>
        </ol>
    </div>
    <div class="container-fluid px-0">
    </div>
    <div class="container-fluid shop py-5">
        <div class="container py-5">
            <div class="row g-4">

                <div class="col-lg-3 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="product-categories mb-4">
                        <h4>Danh mục sản phẩm</h4>
                        <ul class="list-unstyled">
                            <li>
                                <div class="categories-item">
                                    <a href="/shop"
                                        class="text-dark <%= !selectedCategory ? 'fw-bold text-primary' : '' %>">Tất cả
                                        sản phẩm</a>
                                    <span>(<%= products.length %>)</span>
                                </div>
                            </li>
                            <% categories.forEach(category=> { %>
                                <li>
                                    <div class="categories-item">
                                        <a href="/shop?category=<%= encodeURIComponent(category) %>"
                                            class="text-dark <%= selectedCategory === category ? 'fw-bold text-primary' : '' %>">
                                            <%= category %>
                                        </a>
                                        <span>(<%= counts[category] || 0 %>)</span>
                                    </div>
                                </li>
                                <% }) %>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-9 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="rounded mb-4 position-relative">
                        <img src="/img/van-phong-pham-01.jpg" class="img-fluid rounded w-100" style="height: 250px;"
                            alt="Văn phòng phẩm">
                        <div class="position-absolute rounded d-flex flex-column align-items-center justify-content-center text-center"
                            style="width: 100%; height: 250px; top: 0; left: 0; background: rgba(242, 139, 0, 0.3);">
                            <h4 class="display-5 text-primary">BỘ SƯU TẬP EDUSTORE</h4>
                            <a href="/shop" class="btn btn-primary rounded-pill mt-3">Mua ngay</a>
                        </div>
                    </div>

                    <div class="tab-content">
                        <div id="tab-5" class="tab-pane fade show p-0 active">
                            <div class="row g-4">
                                <% if (products && products.length) { %>
                                    <% products.forEach((product, index)=> { %>
                                        <div class="col-lg-4">
                                            <div class="product-item rounded wow fadeInUp"
                                                data-wow-delay="<%= 0.1 + (index % 6)*0.05 %>s">
                                                <div class="product-item-inner border rounded">
                                                    <div class="product-item-inner-item">
                                                        <img src="<%= product.imageUrl %>"
                                                            class="img-fluid w-100 rounded-top"
                                                            alt="<%= product.name %>">
                                                        <div class="product-new">Mới</div>
                                                    </div>
                                                    <div class="text-center rounded-bottom p-4">
                                                        <a href="#" class="d-block mb-2">
                                                            <%= product.category %>
                                                        </a>
                                                        <a href="/product/<%= product._id %>" class="d-block h4">
                                                            <%= product.name %>
                                                        </a>
                                                        <del class="me-2 fs-5">
                                                            <%= (product.price + 10000).toLocaleString('vi-VN') %> đ
                                                        </del>
                                                        <span class="text-primary fs-5">
                                                            <%= product.price.toLocaleString('vi-VN') %> đ
                                                        </span>
                                                    </div>
                                                </div>
                                                <div
                                                    class="product-item-add border border-top-0 rounded-bottom text-center p-4 pt-0">
                                                    <a href="/cart/add/<%= product._id %>"
                                                        class="btn btn-primary border-secondary rounded-pill py-2 px-4 mb-4">
                                                        <i class="fas fa-shopping-cart me-2"></i> Thêm vào giỏ
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <div class="col-12 text-center">
                                                    <p class="fs-5">Chưa có sản phẩm trong danh mục.</p>
                                                </div>
                                                <% } %>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <%- include('partials/footer') %>