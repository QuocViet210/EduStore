    <!-- Shop Page Start -->
    <div class="container-fluid shop py-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-3 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="product-categories mb-4">
                        <h4>Danh mục sản phẩm</h4>
                        <ul class="list-unstyled">
                            <li>
                                <div class="categories-item">
                                    <a href="/shop"
                                        class="text-dark <%= !selectedCategory ? 'fw-bold text-primary' : '' %>">Tất cả
                                        sản phẩm</a>
                                    <span>(<%= products.length %>)</span>
                                </div>
                            </li>
                            <% categories.forEach(category=> { %>
                                <li>
                                    <div class="categories-item">
                                        <a href="/shop?category=<%= encodeURIComponent(category) %>"
                                            class="text-dark <%= selectedCategory === category ? 'fw-bold text-primary' : '' %>">
                                            <%= category %>
                                        </a>
                                        <span>(<%= counts[category] || 0 %>)</span>
                                    </div>
                                </li>
                                <% }) %>
                        </ul>
                    </div>
                    <div class="price mb-4">
                        <h4 class="mb-2">Giá</h4>
                        <input type="range" class="form-range w-100" id="rangeInput" name="rangeInput" min="0"
                            max="500000" value="0" oninput="amount.value=rangeInput.value">
                        <output id="amount" name="amount" min-velue="0" max-value="500000" for="rangeInput">0</output>
                    </div>
                    <div class="product-color mb-3">
                        <h4>Chọn theo màu sắc</h4>
                        <ul class="list-unstyled">
                            <li>
                                <div class="product-color-item">
                                    <a href="#" class="text-dark">Vàng</a>
                                    <span>(2)</span>
                                </div>
                            </li>
                            <li>
                                <div class="product-color-item">
                                    <a href="#" class="text-dark">Xanh lá</a>
                                    <span>(2)</span>
                                </div>
                            </li>
                            <li>
                                <div class="product-color-item">
                                    <a href="#" class="text-dark">Trắng</a>
                                    <span>(2)</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="featured-product mb-4">
                        <h4 class="mb-3">Sản phẩm nổi bật</h4>
                        <% if (products && products.length) { %>
                            <% products.slice(0, 3).forEach((product, index)=> { %>
                                <div class="featured-product-item">
                                    <div class="rounded me-4" style="width: 100px; height: 100px;">
                                        <img src="<%= product.imageUrl %>" class="img-fluid rounded"
                                            alt="<%= product.name %>">
                                    </div>
                                    <div>
                                        <h6 class="mb-2">
                                            <%= product.category %>
                                        </h6>
                                        <div class="d-flex mb-2">
                                            <i class="fa fa-star text-secondary"></i>
                                            <i class="fa fa-star text-secondary"></i>
                                            <i class="fa fa-star text-secondary"></i>
                                            <i class="fa fa-star text-secondary"></i>
                                            <i class="fa fa-star"></i>
                                        </div>
                                        <div class="d-flex mb-2">
                                            <h5 class="fw-bold me-2">
                                                <%= product.price %> đồng
                                            </h5>
                                            <h5 class="text-danger text-decoration-line-through">
                                                <%= product.price + 10000 %> đồng
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
